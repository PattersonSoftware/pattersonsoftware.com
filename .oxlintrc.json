{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "dist",
    "coverage"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.test.{ts,tsx}",
        "src/test/**/*.{ts,tsx}",
        "test-setup.ts"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
